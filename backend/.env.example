# 复制本文件为 .env 并填入你的 Amadeus 免费密钥（可选）。
# 不填则后端自动使用演示数据（模拟价格）。
# 获取方式: https://developers.amadeus.com -> My Self-Service Workspace
#           -> My Apps -> Create new app（环境选 Test）
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# test = 免费测试环境（默认）；production = 已审核的生产环境
AMADEUS_ENV=test

# 后端监听端口 / 地址（默认仅本机可访问；局域网访问改为 0.0.0.0）
PORT=8000
HOST=127.0.0.1
